{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moiseszeleny/feynlag-models/schema/metadata.schema.json",
  "title": "feynlag-models metadata.yaml (schema version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "parents", "problem_addressed",
               "new_fields", "new_symmetries", "free_parameters", "benchmark",
               "key_results", "maturity_level", "maturity_evidence",
               "literature_checks", "references", "feynlag_gaps", "outputs",
               "last_reviewed", "reviewed_by"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "parents": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
    "problem_addressed": {"type": "string", "minLength": 1},
    "new_fields": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "spin", "su3", "su2", "u1y", "generations"],
        "properties": {
          "name": {"type": "string"},
          "symbol": {"type": "string"},
          "spin": {"enum": [0, "1/2", 1]},
          "su3": {"type": "integer"},
          "su2": {"type": "integer"},
          "u1y": {"type": ["number", "string"]},
          "extra_charges": {"type": "object", "additionalProperties": {"type": ["number", "string", "integer"]}},
          "real": {"type": "boolean"},
          "chirality": {"enum": ["L", "R", "Majorana", null]},
          "generations": {"type": "integer", "minimum": 1}
        }
      }
    },
    "new_symmetries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "acts_on", "status"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["gauge", "global", "discrete"]},
          "acts_on": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["exact", "spontaneously_broken", "softly_broken", "explicitly_broken"]},
          "broken_by": {"type": "string"}
        }
      }
    },
    "free_parameters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "mass_dim"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "tex": {"type": "string"},
          "mass_dim": {"type": "integer"},
          "role": {"type": "string"}
        }
      }
    },
    "benchmark": {"type": "object", "additionalProperties": {"type": "number"}},
    "key_results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["statement", "test"],
        "properties": {"statement": {"type": "string"}, "test": {"type": "string"}}
      }
    },
    "maturity_level": {"type": "integer", "minimum": 0, "maximum": 4},
    "maturity_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["L0", "L1", "L2", "L3", "L4"],
      "properties": {
        "L0": {"type": "array", "items": {"type": "string"}},
        "L1": {"type": "array", "items": {"type": "string"}},
        "L2": {"type": "array", "items": {"type": "string"}},
        "L3": {"type": "array", "items": {"type": "string"}},
        "L4": {"type": "array", "items": {"type": "string"}}
      }
    },
    "literature_checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["quantity", "ref", "where", "test"],
        "properties": {
          "quantity": {"type": "string"},
          "ref": {"type": "string"},
          "where": {"type": "string"},
          "test": {"type": "string"}
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "authors", "title"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "authors": {"type": "string"},
          "title": {"type": "string"},
          "venue": {"type": ["string", "null"]},
          "arxiv": {"type": ["string", "null"]},
          "inspire": {"type": ["string", "null"]},
          "doi": {"type": ["string", "null"]}
        }
      }
    },
    "feynlag_gaps": {"type": "array", "items": {"type": "string"}},
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["stamp"],
      "properties": {
        "ufo": {"type": ["string", "null"]},
        "latex": {"type": ["string", "null"]},
        "spectrum": {"type": ["string", "null"]},
        "stamp": {"type": "string"}
      }
    },
    "last_reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "reviewed_by": {"type": "string"}
  }
}
